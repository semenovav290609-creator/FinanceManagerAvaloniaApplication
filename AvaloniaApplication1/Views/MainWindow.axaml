<Window xmlns="https://github.com/avaloniaui"
        x:DataType="vm:MainWindowViewModel"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:AvaloniaApplication1.ViewModels"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
        x:Class="AvaloniaApplication1.Views.MainWindow"
        Icon="C:\Users\Professional\Downloads\fund_16948784.png"
        Title="AvaloniaApplication1">


    <Design.DataContext>
        <vm:MainWindowViewModel/>
    </Design.DataContext>

    <!-- Главный вертикальный контейнер -->
    <StackPanel VerticalAlignment="Top" Spacing="15">

        <!-- Главный заголовок в круглой рамке -->
        <Border Background="#1E293B"
                CornerRadius="10"
                Margin="15,15,15,0"
                Padding="10"
                ClipToBounds="True">
            <TextBlock TextAlignment="Center"
                       FontSize="36"
                       Text="Менеджер финансов"
                       FontWeight="SemiBold"
                       Foreground="White"/>
        </Border>

        <!-- Блок баланса и трат (на одной строке) -->
        <Grid Margin="15,0,15,0">
            <!-- Левый блок: Общий баланс -->
            <Viewbox HorizontalAlignment="Left" StretchDirection="DownOnly" Height="50">
                <Border Background="#E8F8F5" CornerRadius="20" ClipToBounds="True" Padding="10,0,10,0">
                    <TextBlock TextAlignment="Left"
                               Text="{Binding CurrentBalance, StringFormat='Общий баланс: {0:N2} ₽'}"
                               FontSize="32"
                               Foreground="#117A65"
                               Name="balance"/>
                </Border>
            </Viewbox>

            <!-- Правый блок: Итого потрачено -->
            <Viewbox HorizontalAlignment="Right" StretchDirection="DownOnly" Height="45">
                <Border Background="#FADBD8" CornerRadius="20" ClipToBounds="True" Padding="10,0,10,0">
                    <TextBlock TextAlignment="Left"
                               Text="{Binding TotalSpent, StringFormat='Итого потрачено: {0:N2} ₽'}"
                               FontSize="28"
                               Foreground="#78281F"
                               Name="TotalSpent"/>
                </Border>
            </Viewbox>
        </Grid>

        <!-- Основная рабочая сетка из трех колонок -->
        <Grid Margin="15,0,15,0" VerticalAlignment="Top">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="280"/> <!-- Левая колонка под добавление трат -->
                <ColumnDefinition Width="*"/>   <!-- Центральная колонка под историю -->
                <ColumnDefinition Width="280"/> <!-- Правая колонка под пополнение баланса -->
            </Grid.ColumnDefinitions>

            <!-- ЛЕВАЯ КОЛОНКА: Все поля ввода внутри черной рамки -->
            <Border Grid.Column="0"
                    BorderBrush="#CBD5E1"
                    BorderThickness="1"
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Top"
                    Padding="10"
                    CornerRadius="20">
                <StackPanel Spacing="10">
                    <TextBlock Text="Добавить новую трату"
                               FontSize="21"
                               HorizontalAlignment="Center"
                               FontWeight="Bold"
                               Margin="0,0,0,5"/>

                    <!-- 1. Название траты (привязываем к Text) -->
                    <TextBox Watermark="Название траты"
                             HorizontalAlignment="Stretch"
                             CornerRadius="20"
                             Text="{Binding NameWaste, Mode=TwoWay}"/>

                    <!-- 2. Сумма траты (привязываем к Value) -->
                    <!-- Примерно 88-93 строки -->
                    <!-- 2. Сумма траты -->
                    <NumericUpDown Minimum="0"
                                   Increment="10"
                                   FormatString="0.00"
                                   CornerRadius="20"
                                   HorizontalAlignment="Stretch"
                                   Value="{Binding Price, Mode=TwoWay}"/> <!-- Убрали UpdateSourceTrigger -->

                                   <!-- 3. Категория -->
                                   <!-- 3. Категория -->
                                   <ComboBox PlaceholderText="Категория"
                                             HorizontalAlignment="Stretch"
                                             CornerRadius="20"
                                             SelectedIndex="9"
                                             SelectedItem="{Binding SelectedCategory, Mode=TwoWay}">
                                       <ComboBox.Items>
                                           <x:String>Продукты</x:String>
                                           <x:String>Кафе и рестораны</x:String>
                                           <x:String>Транспорт</x:String>
                                           <x:String>Жилье и ЖКХ</x:String>
                                           <x:String>Здоровье и аптеки</x:String>
                                           <x:String>Одежда и обувь</x:String>
                                           <x:String>Развлечения</x:String>
                                           <x:String>Техника</x:String>
                                           <x:String>Подарки</x:String>
                                           <x:String>Прочее</x:String>
                                       </ComboBox.Items>
                                   </ComboBox>






                    <Button Content="Добавить трату"
                            Background="#10B981"
                            Foreground="White"
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Center"
                            CornerRadius="20"
                            Margin="0,5,0,0"
                            Command="{Binding AddWasteCommand}"/>
                </StackPanel>
            </Border>

            <!-- ЦЕНТРАЛЬНАЯ КОЛОНКА: История транзакций -->
            <StackPanel Grid.Column="1"
                        VerticalAlignment="Top"
                        Spacing="10">

                <TextBlock Text="История транзакций"
                           HorizontalAlignment="Center"
                           FontSize="18"
                           FontWeight="Bold"
                           Margin="0,-45,0,0"/>

                <ListBox Height="225"
                         BorderBrush="#CBD5E1"
                         BorderThickness="1"
                         CornerRadius="20"
                         ClipToBounds="True"
                         Margin="10,-10,10,0"
                         ItemsSource="{Binding History}">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Vertical" Margin="0,0,0,12">
                                <!-- Название траты -->
                                <TextBlock Text="{Binding Title}" FontWeight="Bold" FontSize="16" />
                                <!-- Категория -->
                                <TextBlock Text="{Binding Category, StringFormat='Категория: {0}'}" FontSize="12" Foreground="#7F8C8D" />
                                <!-- Сумма -->
                                <TextBlock Text="{Binding Amount, StringFormat='-{0:N2} ₽'}" Foreground="#C0392B" FontSize="14" />
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

            </StackPanel>

            <!-- ПРАВАЯ КОЛОНКА: Пополнение баланса внутри черной рамки -->
            <Border Grid.Column="2"
                    BorderBrush="#CBD5E1"
                    BorderThickness="1"
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Top"
                    CornerRadius="20"
                    Padding="10">
                <StackPanel Spacing="10">
                    <TextBlock Text="Пополнить баланс"
                               FontSize="21"
                               Height="75"
                               HorizontalAlignment="Center"
                               FontWeight="Bold"
                               Margin="0,0,0,5"/>

                    <!-- Поле ввода для пополнения баланса -->
                    <NumericUpDown Minimum="0"
                                   Increment="100"
                                   FormatString="0.00"
                                   HorizontalAlignment="Stretch"
                                   CornerRadius="20"
                                   Value="{Binding BalanceInput, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>




                    <Button Content="Пополнить баланс"
                            Background="#2ECC71"
                            Foreground="White"
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Center"
                            CornerRadius="20"
                            Command="{Binding AddBalanceCommand}"/>

                    <Button Content="Очистить всю историю"
                            Background="#EF4444"
                            Foreground="White"
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Center"
                            CornerRadius="20"
                            Command="{Binding DelHistoryCommand}"/>
                </StackPanel>
            </Border>
        </Grid>

        <!-- Нижний блок накоплений -->
        <Border BorderBrush="#CBD5E1"
                BorderThickness="1"
                CornerRadius="20"
                Margin="15,0,15,15"
                Padding="15">
            <StackPanel Spacing="10">
                <!-- Название и прогресс (теперь берут данные из ViewModel) -->
                <TextBlock Name="DreamTitleText" Text="{Binding DreamTitle}" FontSize="20" FontWeight="Bold"/>
                <TextBlock Name="DreamProgressText" Text="{Binding DreamProgress}" FontSize="14" Foreground="#7F8C8D"/>
                <TextBlock Name="DreamLeftText" Text="{Binding DreamLeft}" FontSize="14" FontWeight="SemiBold" Foreground="#2980B9"/>

                <!-- Полоса прогресса (связана с процентами) -->
                <ProgressBar Name="DreamProgressBar" Minimum="0" Maximum="100" Value="{Binding DreamProgressPercent}" Height="12" CornerRadius="20" Foreground="#3498DB"/>

                <!-- Управление -->
                <WrapPanel Orientation="Horizontal">
                    <!-- Поля ввода ( Mode=TwoWay мгновенно передает текст/числа в C# ) -->
                    <TextBox Watermark="Цель (например, PS5)" Width="180" CornerRadius="20" Margin="0,0,10,5" Name="DreamNameInput" Text="{Binding DreamName, Mode=TwoWay}"/>
                    <NumericUpDown Watermark="Сумма цели" Width="175" CornerRadius="20" Margin="0,0,10,5" Name="DreamTargetInput" Value="{Binding DreamTarget, Mode=TwoWay}"/>

                    <!-- Кнопка ОК -->
                    <Button Content="ОК" Background="#3498DB" Foreground="White" CornerRadius="20" Margin="0,0,20,5" Command="{Binding SaveDreamGoalCommand}"/>

                    <!-- Поле вложить и кнопки -->
                    <NumericUpDown Watermark="Вложить" Width="145" CornerRadius="20" Margin="0,0,10,5" Name="DreamInvestInput" Value="{Binding DreamInvest, Mode=TwoWay}"/>
                    <Button Content="Вложить" Background="#9B59B6" Foreground="White" CornerRadius="20" Margin="0,0,10,5" Command="{Binding InvestInDreamCommand}"/>
                    <Button Content="Сброс" Background="#7F8C8D" Foreground="White" CornerRadius="20" Margin="0,0,0,5" Command="{Binding ResetDreamCommand}"/>
                </WrapPanel>
            </StackPanel>
        </Border>


    </StackPanel>
</Window>
